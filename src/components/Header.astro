---
const navItems = [
  { href: '/', label: 'Start' },
  { href: '/leistungen', label: 'Leistungen' },
  { href: '/prozess', label: 'Prozess' },
  { href: '/dsgvo-trust', label: 'DSGVO & Trust' },
  { href: '/kontakt', label: 'Kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-text">agendt<span class="logo-dot">.</span>de</span>
    </a>
    <nav class="nav-desktop">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/kontakt" class="btn btn-primary header-cta">Kostenloses Erstgespräch</a>
    <button class="nav-toggle" aria-label="Menu" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="nav-mobile" id="nav-mobile">
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a href="/kontakt" class="btn btn-primary" style="margin-top:12px;">Kostenloses Erstgespräch</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10,22,40,0.92);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    height: 68px;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--primary);
    border-bottom: none;
    letter-spacing: -0.03em;
  }

  .logo-dot {
    color: var(--accent);
  }

  .nav-desktop {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .nav-desktop a {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-muted);
    border-bottom: 2px solid transparent;
    padding: 4px 0;
    transition: color 0.2s, border-color 0.2s;
  }

  .nav-desktop a:hover {
    color: var(--primary);
    border-bottom-color: var(--accent);
  }

  .nav-desktop a.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  .header-cta {
    font-size: 0.85rem;
    padding: 10px 20px;
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--primary);
    border-radius: 2px;
    transition: 0.3s;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 16px 24px 24px;
    border-top: 1px solid var(--border);
    background: var(--bg-alt);
  }

  .nav-mobile.open {
    display: flex;
  }

  .nav-mobile a {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 860px) {
    .nav-desktop { display: none; }
    .header-cta { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    mobile?.classList.toggle('open');
    toggle.classList.toggle('active');
  });
</script>
