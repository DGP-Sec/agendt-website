---
const navItems = [
  { href: '/', label: 'Start' },
  { href: '/leistungen/ki-beratung/', label: 'KI-Beratung' },
  { href: '/leistungen/automatisierung/', label: 'Automatisierung' },
  { href: '/leistungen/chatbot/', label: 'Chatbot' },
  { href: '/leistungen/ki-agent/', label: 'KI-Agent' },
  { href: '/leistungen/ki-texte/', label: 'KI-Texte' },
  { href: '/preise/', label: 'Preise' },
  { href: '/faq/', label: 'FAQ' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <span class="logo-text">agendt<span class="logo-dot">.</span>de</span>
    </a>
    <nav class="nav-desktop" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <a href="/kontakt/" class="btn btn-primary header-cta">Angebot einholen</a>
    <button class="nav-toggle" aria-label="Menü öffnen" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav class="nav-mobile" id="nav-mobile">
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
    <a href="/kontakt/" class="btn btn-primary" style="margin-top:12px;">Angebot einholen</a>
  </nav>
</header>

<style>
  .contact-bar {
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
  }
  .contact-bar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 8px 24px;
    flex-wrap: wrap;
  }
  .contact-bar-item {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-muted);
    font-weight: 500;
    border-bottom: none;
  }
  .contact-bar-item:hover { color: var(--accent); }
  .contact-bar-item.static { cursor: default; }
  .contact-bar-item.static:hover { color: var(--text-muted); }
  .cb-icon { color: var(--accent); font-size: 0.9rem; }
  .contact-bar-sep {
    width: 1px; height: 14px;
    background: var(--border);
  }
  @media (max-width: 640px) { .contact-bar-sep { display: none; } }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(17, 24, 39, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 0 24px;
    height: 72px;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .logo {
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
    border-bottom: none;
    flex-shrink: 0;
  }

  .logo-dot { color: var(--accent); }

  .nav-desktop {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .nav-desktop a {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 8px 10px;
    border-radius: 6px;
    transition: color 0.2s, background 0.2s;
  }

  .nav-desktop a:hover {
    color: var(--text);
    background: var(--bg-card);
  }

  .nav-desktop a.active {
    color: var(--accent);
    background: var(--accent-bg);
  }

  .header-cta {
    font-size: 0.88rem;
    padding: 11px 22px;
    border-radius: 10px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }

  .nav-toggle span {
    width: 24px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: 0.3s;
  }

  .nav-mobile {
    display: none;
    flex-direction: column;
    gap: 8px;
    padding: 16px 24px 24px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .nav-mobile.open { display: flex; }

  .nav-mobile a {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  @media (max-width: 1080px) {
    .nav-desktop { display: none; }
    .header-cta { display: none; }
    .nav-toggle { display: flex; }
  }
</style>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => {
    mobile?.classList.toggle('open');
    toggle.classList.toggle('active');
  });
</script>
