---
export interface Props {
  title: string;
  body: string;
  icon?: string;
}

const { title, body, icon } = Astro.props;
---

<div class="card">
  {icon && <div class="card-icon" set:html={icon} />}
  <h3 class="card-title">{title}</h3>
  <p class="card-body">{body}</p>
</div>

<style>
  .card-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-bg);
    border-radius: var(--radius);
    margin-bottom: 20px;
    color: var(--accent);
    font-size: 1.4rem;
  }

  .card-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .card-title {
    font-size: 1.15rem;
    color: var(--text);
    margin-bottom: 10px;
  }

  .card-body {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }
</style>
