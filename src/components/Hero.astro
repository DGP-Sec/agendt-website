---
// Hero: Loss Aversion (Kahneman/Tversky) + Klarheit (Cognitive Ease)
// Verluste sind psychologisch ~2x stärker als Gewinne -> Problem zuerst, dann Lösung
---

<section class="hero">
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>
  <div class="orb orb-3" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-content">
      <p class="hero-label">KI-Automatisierung · Made in Germany</p>
      <h1 class="hero-title">
        Wie viele Stunden verliert Ihr Team<br>
        <span class="hero-highlight">an Wiederholungsarbeiten?</span>
      </h1>
      <p class="hero-sub">
        Wir automatisieren Ihre Geschäftsprozesse mit KI-Workflows, lokalen Sprachmodlen und n8n.
        Prototyp in 3–5 Tagen. DSGVO-konform. Keine US-Cloud.
      </p>
      <div class="hero-cta">
        <a href="/kontakt" class="btn btn-primary btn-large">
          Kostenloses Erstgespräch →
        </a>
        <a href="/leistungen" class="btn btn-secondary btn-large">
          Leistungen ansehen
        </a>
      </div>
      <div class="hero-trust">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          <span>Antwort < 24h</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>100% DSGVO-konform</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          <span>Self-Hosted möglich</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-alt) 100%);
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent-bg) 0%, transparent 70%);
    opacity: 0.75;
    pointer-events: none;
  }

  /* Ambient Orbs (Everlast-Stil): langsam schwebende, verwischte Lichtkreise */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
    opacity: 0.5;
  }

  .orb-1 {
    width: 420px; height: 420px;
    top: -120px; left: -140px;
    background: radial-gradient(circle, rgba(212, 160, 23, 0.14) 0%, transparent 70%);
    animation: orbFloat1 22s ease-in-out infinite;
  }

  .orb-2 {
    width: 300px; height: 300px;
    bottom: -60px; right: -80px;
    background: radial-gradient(circle, rgba(46, 90, 148, 0.28) 0%, transparent 70%);
    animation: orbFloat2 27s ease-in-out infinite;
  }

  .orb-3 {
    width: 200px; height: 200px;
    top: 30%; left: 55%;
    background: radial-gradient(circle, rgba(212, 160, 23, 0.08) 0%, transparent 70%);
    animation: orbFloat3 32s ease-in-out infinite;
  }

  @keyframes orbFloat1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(60px, 40px) scale(1.08); }
  }

  @keyframes orbFloat2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, -30px) scale(1.12); }
  }

  @keyframes orbFloat3 {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.4; }
    50% { transform: translate(-40px, 50px) scale(1.15); opacity: 0.6; }
  }

  .hero-content {
    max-width: 780px;
    position: relative;
    z-index: 1;
  }

  .hero-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--primary);
    margin-bottom: 24px;
    letter-spacing: -0.03em;
  }

  .hero-highlight {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    color: var(--accent-light);
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 36px;
    max-width: 620px;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-trust {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .trust-item svg {
    color: var(--success);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .hero { padding: 60px 0 48px; }
    .hero-trust { gap: 16px; }
    .hero-cta { flex-direction: column; }
    .hero-cta .btn { width: 100%; justify-content: center; }
  }
</style>
