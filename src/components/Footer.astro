---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <span class="logo">agendt<span class="dot">.</span>de</span>
        <p class="footer-desc">KI-Automatisierung für Immobilien und E-Commerce. DSGVO-konform, self-hosted, praxisnah.</p>
        <div class="footer-badges">
          <span class="badge">DSGVO-konform</span>
          <span class="badge">Self-Hosted</span>
          <span class="badge">Made in Germany</span>
        </div>
      </div>

      <div class="footer-col">
        <h4>Services</h4>
        <a href="/leistungen/ki-beratung/">KI-Beratung</a>
        <a href="/leistungen/automatisierung/">Automatisierung</a>
        <a href="/leistungen/chatbot/">Chatbot</a>
        <a href="/leistungen/ki-agent/">KI-Agent</a>
        <a href="/leistungen/ki-texte/">KI-Texte</a>
      </div>

      <div class="footer-col">
        <h4>Unternehmen</h4>
        <a href="/">Start</a>
        <a href="/prozess/">Prozess</a>
        <a href="/preise/">Preise</a>
        <a href="/faq/">FAQ</a>
        <a href="/kontakt/">Kontakt</a>
      </div>

      <div class="footer-col">
        <h4>Rechtliches</h4>
        <a href="/impressum/">Impressum</a>
        <a href="/datenschutz/">Datenschutzerklärung</a>
        <a href="/dsgvo-trust/">DSGVO & Trust</a>
      </div>

      <div class="footer-col">
        <h4>Kontakt</h4>
        <a href="mailto:hello@agendt.de">hello@agendt.de</a>
        <p class="footer-note">Antwort innerhalb von 24 Stunden an Werktagen.</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} agendt.de · Alle Rechte vorbehalten.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-alt);
    color: var(--text-muted);
    padding: 64px 0 32px;
    border-top: 1px solid var(--border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  .logo {
    font-family: 'Inter', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .dot { color: var(--accent); }

  .footer-desc {
    margin-top: 12px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .footer-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .badge {
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 6px;
    padding: 4px 10px;
  }

  .footer-col h4 {
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text);
    margin-bottom: 16px;
  }

  .footer-col a {
    display: block;
    font-size: 0.9rem;
    color: var(--text-muted);
    padding: 4px 0;
    transition: color 0.2s;
  }

  .footer-col a:hover { color: var(--accent); }

  .footer-note {
    font-size: 0.82rem;
    color: var(--text-light);
    margin-top: 8px;
    opacity: 0.8;
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    text-align: center;
  }

  .footer-bottom p {
    font-size: 0.82rem;
    color: var(--text-light);
  }

  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
