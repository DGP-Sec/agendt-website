---
export interface Props {
  label?: string;
  title?: string;
  intro?: string;
  alt?: boolean;
  dark?: boolean;
}

const { label, title, intro, alt = false, dark = false } = Astro.props;

const classes = ['section'];
if (alt) classes.push('section-alt');
if (dark) classes.push('section-dark');
---

<section class={classes.join(' ')}>
  <div class="container">
    {label && <p class="section-label">{label}</p>}
    {title && <h2 class="section-title" set:html={title} />}
    {intro && <p class="section-intro" set:html={intro} />}
    <slot />
  </div>
</section>
