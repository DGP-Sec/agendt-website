---
export interface Props {
  title?: string;
  intro?: string;
  alt?: boolean;
  dark?: boolean;
  light?: boolean;
  box?: boolean;
  center?: boolean;
}

const { title, intro, alt = false, dark = false, light = false, box = false, center = true } = Astro.props;

const classes = ['section'];
if (light) classes.push('section-light');
else if (alt || dark) classes.push('section-alt');
if (box) classes.push('shell-box');
if (center) classes.push('has-center');
---

<section class={classes.join(' ')}>
  <div class="container">
    {title && <h2 class="section-title" set:html={title} style={center ? 'text-align:center;' : ''} />}
    {intro && <p class="section-intro" set:html={intro} />}
    <slot />
  </div>
</section>
