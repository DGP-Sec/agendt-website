---
export interface Props {
  title: string;
  description: string;
  outcome?: string;
}

const { title, description, outcome } = Astro.props;
---

<li class="service-item">
  <div class="service-header">
    <span class="service-arrow">→</span>
    <div>
      <h3 class="service-title">{title}</h3>
      <p class="service-desc">{description}</p>
      {outcome && <p class="service-outcome"><span class="outcome-label">Ergebnis:</span> {outcome}</p>}
    </div>
  </div>
</li>

<style>
  .service-item {
    list-style: none;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    transition: transform 0.2s;
  }

  .service-item:last-child { border-bottom: none; }

  .service-item:hover { transform: translateX(6px); }

  .service-header {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }

  .service-arrow {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
    line-height: 1.5;
  }

  .service-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: 6px;
  }

  .service-desc {
    font-size: 0.96rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .service-outcome {
    margin-top: 8px;
    font-size: 0.88rem;
    color: var(--success);
    font-weight: 500;
  }

  .outcome-label {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.78rem;
  }

  @media (max-width: 640px) {
    .service-header { gap: 12px; }
    .service-arrow { font-size: 1rem; }
  }
</style>
