---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import QuizFinder from '../components/QuizFinder.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { icons } from '../lib/icons';

// FAQ sinngemäß nach Vorbild-Struktur, mit unseren Zahlen
const faqs = [
  {
    q: 'Wie schnell kann KI-Automatisierung implementiert werden?',
    a: 'Ein lauffähiger Prototyp steht in 3–5 Werktagen. Die vollständige Umsetzung dauert je nach Umfang 1–4 Wochen. Wir starten bewusst mit dem Prozess, der sofort Mehrwert schafft.',
  },
  {
    q: 'Welche Kosten entstehen bei KI-Automatisierung?',
    a: 'Der Einstieg (KI-Scan) ist kostenlos. Ein Prototyp startet ab 1.500 € Festpreis, eine Voll-Automatisierung ab 4.500 €. Alle Details auf unserer Preisseite.',
  },
  {
    q: 'Welche Prozesse können automatisiert werden?',
    a: 'Fast alle wiederkehrenden Prozesse: E-Mail-Bearbeitung, Kundenanfragen, Datenerfassung, Rechnungsprüfung, Lead-Qualifizierung, Terminkoordination, Reporting und vieles mehr.',
  },
  {
    q: 'Ist KI-Automatisierung sicher und datenschutzkonform?',
    a: 'Ja. Wir setzen vorrangig auf self-hosted Modelle und europäische Infrastruktur – Ihre Daten verlassen Ihr Netzwerk nicht. Alles wird DSGVO-konform dokumentiert.',
  },
  {
    q: 'Brauchen wir technisches Know-how für KI-Automatisierung?',
    a: 'Nein. Wir übernehmen die komplette Umsetzung und schulen Ihr Team. Sie konzentrieren sich auf Ihre Prozesse, wir auf die Technik.',
  },
  {
    q: 'Wie messen wir den Erfolg der KI-Automatisierung?',
    a: 'Wir definieren gemeinsam klare KPIs: Zeitersparnis, Kostenreduktion, Fehlerquote, Durchsatzgeschwindigkeit. Sie erhalten transparente, nachvollziehbare Ergebnisse.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'agendt.de',
  url: 'https://agendt.de',
  email: 'hello@agendt.de',
  description: 'KI-Automatisierung für Immobilien und E-Commerce. DSGVO-konform, self-hosted, praxisnah.',
};
---

<Base
  title="Geschäftsprozesse mit KI automatisieren | agendt.de"
  description="Sparen Sie bis zu 70% Zeit bei Routineaufgaben: E-Mails, Kundenanfragen, Datenerfassung und mehr – mit DSGVO-konformer KI. Prototyp in 3–5 Tagen."
>
  <Header />

  <main style="--max-w: 1264px;">
  <!-- HERO: Große Headline, 2 CTAs, 3 Trust-Badges, Visual rechts -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <h1 class="hero-title">Geschäftsprozesse automatisieren mit KI</h1>
        <p class="hero-sub">
          Sparen Sie bis zu 70% Zeit bei Routineaufgaben. Automatisieren Sie E-Mails,
          Kundenanfragen, Datenerfassung und mehr – mit intelligenter KI-Technologie.
        </p>
        <div class="hero-cta">
          <a href="/kontakt/" class="btn btn-primary btn-large">Kostenlose Beratung</a>
          <a href="#ki-finder" class="btn btn-secondary btn-large">KI-Lösung finden</a>
        </div>
        <div class="hero-badges">
          <div class="hero-badge">
            <span class="badge-icon" set:html={icons.zap} />
            <span>Prototyp in 3–5 Tagen</span>
          </div>
          <div class="hero-badge">
            <span class="badge-icon" set:html={icons.shield} />
            <span>DSGVO-konform</span>
          </div>
          <div class="hero-badge">
            <span class="badge-icon" set:html={icons.target} />
            <span>Individuelle Lösungen</span>
          </div>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="hv-panel">
          <div class="hv-head">
            <span class="hv-dot"></span><span class="hv-dot"></span><span class="hv-dot"></span>
            <span class="hv-live-dot" aria-hidden="true"></span><span class="hv-title">Workflow · live</span>
          </div>
          <div class="hv-rows" id="hv-flow">
            <div class="hv-row">
              <span class="hv-icon" set:html={icons.mail} />
              <span class="hv-label">E-Mail eingeht</span>
              <span class="hv-status"><svg class="st-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span class="st-run"></span></span>
            </div>
            <div class="hv-arrow">&#8595;</div>
            <div class="hv-row">
              <span class="hv-icon" set:html={icons.bot} />
              <span class="hv-label">KI klassifiziert</span>
              <span class="hv-status"><svg class="st-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span class="st-run"></span></span>
            </div>
            <div class="hv-arrow">&#8595;</div>
            <div class="hv-row">
              <span class="hv-icon" set:html={icons.chart} />
              <span class="hv-label">CRM aktualisiert</span>
              <span class="hv-status"><svg class="st-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span class="st-run"></span></span>
            </div>
            <div class="hv-arrow">&#8595;</div>
            <div class="hv-row">
              <span class="hv-icon" set:html={icons.calendar} />
              <span class="hv-label">Termin gebucht</span>
              <span class="hv-status"><svg class="st-ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span class="st-run"></span></span>
            </div>
          </div>
          <div class="hv-foot">n8n · self-hosted · 0 ms API-Latenz</div>
        </div>
        <div class="hv-glow hv-glow-1"></div>
        <div class="hv-glow hv-glow-2"></div>
      </div>
    </div>
  </section>

  <!-- QUIZ FINDER -->
  <QuizFinder />

  <!-- WARUM KI-AUTOMATISIERUNG: 3 Vorteil-Karten mit Ergebnis-Zeile -->
  <Section
    light
    box
    title="Warum KI-Automatisierung?"
    intro="Geschäftsprozesse automatisieren bedeutet mehr als Effizienzsteigerung – es ist ein strategischer Wettbewerbsvorteil."
  >
    <div class="why-grid reveal-stagger">
      <div class="card why-card">
        <div class="card-icon" set:html={icons.clock} />
        <h3 class="card-title">Zeit sparen durch intelligente Automatisierung</h3>
        <p class="card-body">
          Ihre Mitarbeiter verbringen täglich Stunden mit wiederkehrenden Aufgaben: E-Mails sortieren,
          Daten eingeben, Anfragen beantworten, Termine koordinieren. KI-Automatisierung übernimmt diese
          Routine – präzise, schnell und rund um die Uhr.
        </p>
        <p class="why-result"><span class="why-result-label">Ergebnis:</span> Bis zu 70% Zeitersparnis bei Routineaufgaben</p>
      </div>
      <div class="card why-card">
        <div class="card-icon" set:html={icons.coins} />
        <h3 class="card-title">Kosten senken mit skalierbarer KI</h3>
        <p class="card-body">
          Manuelle Prozesse sind teuer – durch Personalkosten, Fehler und fehlende Skalierbarkeit.
          Self-hosted KI-Systeme arbeiten ohne laufende API-Kosten und wachsen mit, ohne dass Aufwand
          und Kosten linear mitsteigen.
        </p>
        <p class="why-result"><span class="why-result-label">Ergebnis:</span> Geringere Prozesskosten, planbare Festpreise</p>
      </div>
      <div class="card why-card">
        <div class="card-icon" set:html={icons.shieldCheck} />
        <h3 class="card-title">Fehlerquote minimieren durch Automatisierung</h3>
        <p class="card-body">
          Menschliche Fehler bei monotonen Aufgaben sind unvermeidlich – jeder kostet Zeit, Geld oder
          Kundenvertrauen. Automatisierte Prozesse arbeiten reproduzierbar genau und dokumentieren jeden
          Schritt für volle Nachvollziehbarkeit.
        </p>
        <p class="why-result"><span class="why-result-label">Ergebnis:</span> Deutlich weniger Fehler, lückenlose Protokolle</p>
      </div>
    </div>
  </Section>

  <!-- 3-SCHRITTE-PROZESS -->
  <Section
    alt
    box
    title="Unser 3-Schritte-Prozess"
    intro="Von der Analyse bis zum erfolgreichen Rollout – transparent und planbar."
  >
    <div class="process-grid reveal-stagger">
      <div class="process-col">
        <span class="process-num">01</span>
        <h3 class="process-title">Analyse &amp; Erstgespräch</h3>
        <p class="process-text">
          Wir starten mit einem intensiven Gespräch über Ihre Abläufe. Gemeinsam erstellen wir ein
          Prozess-Mapping und identifizieren die größten Automatisierungshebel.
        </p>
        <ul class="check-list">
          <li>Detailliertes Prozess-Mapping</li>
          <li>Potenzialanalyse mit Aufwand/Nutzen</li>
          <li>Quick-Wins identifizieren</li>
          <li>Priorisierung nach Wirkung</li>
        </ul>
      </div>
      <div class="process-col">
        <span class="process-num">02</span>
        <h3 class="process-title">Prototyp &amp; Testing</h3>
        <p class="process-text">
          Wir entwickeln einen lauffähigen Prototyp für Ihren wichtigsten Anwendungsfall. Sie testen
          mit echten Daten und sehen den Mehrwert, bevor Sie in die volle Umsetzung investieren.
        </p>
        <ul class="check-list">
          <li>Funktionsfähiger Prototyp in 3–5 Tagen</li>
          <li>Testing mit echten Daten</li>
          <li>Iterative Optimierung mit Ihrem Feedback</li>
          <li>Messbare Ergebnisse vor der Umsetzung</li>
        </ul>
      </div>
      <div class="process-col">
        <span class="process-num">03</span>
        <h3 class="process-title">Rollout &amp; Optimierung</h3>
        <p class="process-text">
          Nach erfolgreichem Test überführen wir die Lösung Schritt für Schritt in Ihren Live-Betrieb.
          Wir schulen Ihr Team, dokumentieren alles und optimieren kontinuierlich.
        </p>
        <ul class="check-list">
          <li>Schrittweise Einführung im Betrieb</li>
          <li>Training für Ihr Team</li>
          <li>Umfassende Dokumentation</li>
          <li>Kontinuierliche Verbesserung</li>
        </ul>
      </div>
    </div>
    <p class="process-more"><a href="/prozess/">Details zum Prozess-Ablauf →</a></p>
  </Section>

  <!-- ANWENDUNGSFÄLLE: 4 Branchen -->
  <Section
    light
    box
    title="Bewährte Anwendungsfälle"
    intro="KI-Automatisierung funktioniert branchenübergreifend – hier sind vier typische Beispiele."
  >
    <div class="usecase-grid reveal-stagger">
      <div class="card usecase-card">
        <div class="card-icon" set:html={icons.cart} />
        <h3 class="card-title">E-Commerce</h3>
        <p class="card-body">
          <strong>KI-Chatbot</strong> beantwortet den Großteil der Standardfragen zu Bestellstatus, Rücksendungen
          und Produkten – rund um die Uhr. <strong>Automatische Statusupdates</strong>, Versandbenachrichtigungen
          und Follow-ups steigern die Kundenzufriedenheit.
        </p>
      </div>
      <div class="card usecase-card">
        <div class="card-icon" set:html={icons.home} />
        <h3 class="card-title">Immobilienwirtschaft</h3>
        <p class="card-body">
          <strong>Exposé-Anfragen</strong> werden sofort beantwortet, Interessenten vorqualifiziert und
          Besichtigungen direkt gebucht. <strong>Objektdaten</strong> fließen automatisch aus Portalen und
          Dokumenten in Ihre Systeme.
        </p>
      </div>
      <div class="card usecase-card">
        <div class="card-icon" set:html={icons.briefcase} />
        <h3 class="card-title">B2B-Service</h3>
        <p class="card-body">
          <strong>KI-Agenten</strong> analysieren eingehende Anfragen, bewerten die Lead-Qualität und leiten an
          den richtigen Vertriebler weiter. <strong>Automatische Follow-ups</strong> und Aktivitäts-Protokolle
          inklusive.
        </p>
      </div>
      <div class="card usecase-card">
        <div class="card-icon" set:html={icons.chart} />
        <h3 class="card-title">Finance &amp; Controlling</h3>
        <p class="card-body">
          <strong>Automatische Extraktion</strong> von Rechnungsdaten, Abgleich mit Bestellungen und
          Freigabe-Workflows. <strong>KI-gestützte Reports</strong> erkennen Anomalien und schaffen
          Transparenz.
        </p>
      </div>
    </div>
    <p class="process-more"><a href="/leistungen/">Weitere Einsatzbereiche entdecken →</a></p>
  </Section>

  <!-- TECHNOLOGIE -->
  <Section
    alt
    box
    title="Moderne KI-Technologie – sicher in Ihrer Hand"
    intro="Wir setzen auf selbst gehostete Open-Source-Modelle und europäische Anbieter – DSGVO-konform, transparent, ohne Abhängigkeit."
  >
    <div class="tech-grid">
      <div class="tech-visual" aria-hidden="true">
        <div class="tv-stack">
          <div class="tv-chip tv-chip-1">n8n</div>
          <div class="tv-chip tv-chip-2">Ollama · Llama</div>
          <div class="tv-chip tv-chip-3">Qdrant</div>
          <div class="tv-chip tv-chip-4">Docker</div>
        </div>
        <div class="tv-glow"></div>
      </div>
      <div class="tech-features">
        <div class="tech-feature">
          <span class="tf-icon" set:html={icons.shield} />
          <div>
            <h3>DSGVO-konform &amp; sicher</h3>
            <p>Daten bleiben auf Ihrer Infrastruktur oder bei europäischen Anbietern. Alle Datenflüsse werden dokumentiert.</p>
          </div>
        </div>
        <div class="tech-feature">
          <span class="tf-icon" set:html={icons.bot} />
          <div>
            <h3>Passende KI-Modelle</h3>
            <p>Wir wählen pro Anwendungsfall das passende Modell: lokal, offen und unabhängig – statt Standard-Cloud.</p>
          </div>
        </div>
        <div class="tech-feature">
          <span class="tf-icon" set:html={icons.pin} />
          <div>
            <h3>Skalierbar &amp; offen</h3>
            <p>Open Source statt Vendor-Lock-in: Was wir bauen, gehört Ihnen – und wächst mit Ihrem Unternehmen.</p>
          </div>
        </div>
        <a href="/kontakt/" class="btn btn-primary">Jetzt beraten lassen</a>
      </div>
    </div>
  </Section>

  <!-- STATS BAND -->
  <section class="stats-band section-light shell-box">
    <div class="container stats-grid">
      <div class="stat">
        <span class="stat-num">3–5</span>
        <span class="stat-label">Tage bis zum lauffähigen Prototyp</span>
      </div>
      <div class="stat">
        <span class="stat-num">70%</span>
        <span class="stat-label">Zeitersparnis bei Routineaufgaben (bis zu)</span>
      </div>
      <div class="stat">
        <span class="stat-num">100%</span>
        <span class="stat-label">DSGVO-konforme Architektur</span>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <Section
    alt
    box
    title="Häufig gestellte Fragen"
    intro="Die wichtigsten Fragen vor dem Start – ehrlich beantwortet."
  >
    <div class="faq-list reveal">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a} {f.q.includes('Kosten') && <a href="/preise/">Mehr zu unseren Preisen</a>}</p>
        </details>
      ))}
    </div>
    <p class="process-more"><a href="/faq/">Alle FAQs ansehen →</a></p>
  </Section>

  <!-- FINAL CTA -->
  <section class="final-cta shell-box">
    <div class="container text-center">
      <h2 class="cta-title">Bereit für den nächsten Schritt?</h2>
      <p class="cta-sub">Kostenloses Erstgespräch: 20 Minuten, konkret, unverbindlich.</p>
      <a href="/kontakt/" class="btn btn-primary btn-large">Jetzt Beratungstermin vereinbaren</a>
    </div>
  </section>

  <script>
    // Live-Workflow-Sequenz: Block für Block verarbeiten, Paket zum nächsten,
    // am Ende kurzer Halt, dann Reset. Läuft nur im sichtbaren Bereich.
    (() => {
      const panel = document.getElementById('hv-flow');
      if (!panel) return;
      const rows = Array.from(panel.querySelectorAll('.hv-row'));
      const arrows = Array.from(panel.querySelectorAll('.hv-arrow'));
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (reduce.matches || !('IntersectionObserver' in window)) {
        rows.forEach((r) => r.classList.add('is-done'));
        return;
      }

      const PROC = 1300;   // Dauer "verarbeitet"
      const FLOW = 550;    // Dauer Daten-Paket
      const GAP = 350;     // Pause zwischen Blöcken
      const HOLD = 2800;   // Halt nach letztem Block
      let timers = [];
      let running = false;

      const reset = () => {
        rows.forEach((r) => r.classList.remove('is-processing', 'is-done'));
        arrows.forEach((a) => a.classList.remove('is-flowing'));
      };

      const cycle = () => {
        if (!running) return;
        reset();
        rows.forEach((row, i) => {
          const t0 = i * (PROC + FLOW + GAP);
          timers.push(setTimeout(() => row.classList.add('is-processing'), t0));
          timers.push(setTimeout(() => {
            row.classList.remove('is-processing');
            row.classList.add('is-done');
            if (arrows[i]) arrows[i].classList.add('is-flowing');
          }, t0 + PROC));
          if (arrows[i]) {
            timers.push(setTimeout(() => arrows[i].classList.remove('is-flowing'), t0 + PROC + FLOW));
          }
        });
        timers.push(setTimeout(cycle, rows.length * (PROC + FLOW + GAP) + HOLD));
      };

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting && !running) {
            running = true;
            cycle();
          } else if (!e.isIntersecting && running) {
            running = false;
            timers.forEach(clearTimeout);
            timers = [];
            reset();
          }
        });
      }, { threshold: 0.25 });
      io.observe(panel);
    })();
  </script>
  </main>

  <ScrollReveal />
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
</Base>

<style>
  /* Landing-Page: Root-Font-Size angehoben — skaliert die komplette rem-basierte
     Typografie konsistent hoch (H1/H2/Fließtext/Buttons), ohne Unterseiten
     zu berühren (Workflow: erst Landing final, dann Transfer). */
  :global(html) { font-size: 17px; }

  /* HERO */
  .hero {
    padding: 96px 0 80px;
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
  }
  .hero-title {
    font-size: clamp(2.35rem, 5.3vw, 4.25rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 20px;
    letter-spacing: -0.03em;
  }
  .hero-sub {
    font-size: 1.2rem;
    color: var(--text-muted);
    max-width: 520px;
    margin-bottom: 32px;
  }
  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }
  .hero-badges {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
  }
  .badge-icon { color: var(--accent); display: inline-flex; }
  .badge-icon :global(svg) { width: 16px; height: 16px; }

  /* Hero-Visual: Workflow-Panel */
  .hero-visual { position: relative; }
  .hv-panel {
    position: relative;
    z-index: 1;
    background: rgba(31, 41, 55, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }
  .hv-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: var(--bg-input);
    border-bottom: 1px solid var(--border);
  }
  .hv-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--border-hover); }
  .hv-dot:first-child { background: var(--danger); opacity: 0.7; }
  .hv-dot:nth-child(2) { background: var(--accent); opacity: 0.7; }
  .hv-dot:nth-child(3) { background: var(--success); opacity: 0.7; }
  .hv-title { margin-left: 8px; font-size: 0.75rem; color: var(--text-light); font-family: ui-monospace, monospace; }
  .hv-rows { padding: 20px 16px; }

  /* Live-Dot im Panel-Kopf */
  .hv-live-dot {
    width: 8px; height: 8px;
    margin-left: 10px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(212, 175, 55, 0.8);
    animation: hvLiveBlink 2s ease-in-out infinite;
  }
  @keyframes hvLiveBlink { 0%,100% { opacity: 1; } 50% { opacity: 0.35; } }

  /* Workflow-Zeilen: warten -> verarbeiten -> fertig */
  .hv-row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--bg-input);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius);
    padding: 12px 14px;
    opacity: 0.45;
    transition: opacity 0.4s, border-color 0.4s, box-shadow 0.4s;
  }
  .hv-row.is-processing {
    opacity: 1;
    border-color: rgba(212, 175, 55, 0.5);
    box-shadow: 0 0 18px rgba(212, 175, 55, 0.14);
  }
  .hv-row.is-processing .hv-icon { animation: hvIconPulse 1s ease-in-out infinite; }
