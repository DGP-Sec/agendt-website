---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ServiceItem from '../components/ServiceItem.astro';
import Card from '../components/Card.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

// SVG Icons (inline für Performance)
const iconProcess = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>';
const iconContent = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>';
const iconShield = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>';
const iconServer = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>';
---

<Base>
  <Header />
  <Hero />

  <!-- STATS BAR: Social Proof durch konkrete Zahlen (Cialdini) -->
  <div class="stats-bar">
    <div class="container">
      <div class="stats-grid reveal-stagger">
        <div class="stat">
          <span class="stat-num">3–5</span>
          <span class="stat-label">Tage bis zum Prototyp</span>
        </div>
        <div class="stat">
          <span class="stat-num" data-count="24" data-prefix="&lt; " data-suffix="h">&lt; 24h</span>
          <span class="stat-label">Antwortzeit an Werktagen</span>
        </div>
        <div class="stat">
          <span class="stat-num" data-count="100" data-suffix="%">100%</span>
          <span class="stat-label">DSGVO-konforme Architektur</span>
        </div>
        <div class="stat">
          <span class="stat-num">0</span>
          <span class="stat-label">US-Cloud-Abhängigkeit</span>
        </div>
      </div>
    </div>
  </div>

  <!-- TECH-MARQUEE: endloses Laufband unseres Stacks (pausiert bei Hover) -->
  <div class="tech-marquee" aria-label="Verwendete Technologien">
    <div class="marquee-track">
      <span class="tech-chip">n8n</span><span class="tech-chip">Ollama</span><span class="tech-chip">Llama</span><span class="tech-chip">Python</span><span class="tech-chip">TypeScript</span><span class="tech-chip">Next.js</span><span class="tech-chip">PostgreSQL</span><span class="tech-chip">Docker</span><span class="tech-chip">GitHub Actions</span><span class="tech-chip">Cloudflare</span><span class="tech-chip">OpenAI-kompatible APIs</span><span class="tech-chip">IMAP / SMTP</span><span class="tech-chip">n8n</span><span class="tech-chip">Ollama</span><span class="tech-chip">Llama</span><span class="tech-chip">Python</span><span class="tech-chip">TypeScript</span><span class="tech-chip">Next.js</span><span class="tech-chip">PostgreSQL</span><span class="tech-chip">Docker</span><span class="tech-chip">GitHub Actions</span><span class="tech-chip">Cloudflare</span><span class="tech-chip">OpenAI-kompatible APIs</span><span class="tech-chip">IMAP / SMTP</span>
    </div>
  </div>

  <!-- PROBLEM SECTION: Loss Aversion (Kahneman/Tversky) -->
  <Section
    label="[Das Problem]"
    title="Jeder Tag ohne Automatisierung kostet Sie <em class='hl'>bares Geld.</em>"
    intro="Repetitive Aufgaben binden Personal, das eigentlich für Wichtigeres gebraucht wird. Während Ihre Mitarbeiter Daten abtippen, Exposés formatieren und E-Mails sortieren, macht die Konkurrenz bereits mehr mit weniger Aufwand."
  >
    <div class="pain-grid reveal-stagger">
      <div class="pain-item">
        <span class="pain-icon">&#9888;</span>
        <p><strong>Manuelle Datenpflege</strong> zwischen CRM, Shop und Portalen – stündlich, täglich, fehleranfällig.</p>
      </div>
      <div class="pain-item">
        <span class="pain-icon">&#9888;</span>
        <p><strong>Wiederkehrende Kundenanfragen</strong>, die immer ähnlich sind und ehemalig viel Zeit kosten.</p>
      </div>
      <div class="pain-item">
        <span class="pain-icon">&#9888;</span>
        <p><strong>Inhalte müssen erstellt werden</strong> – Exposés, Produktbeschreibungen, Social-Media-Posts. Immer wieder von vorn.</p>
      </div>
      <div class="pain-item">
        <span class="pain-icon">&#9888;</span>
        <p><strong>Datenflut ohne Struktur</strong> – Dokumente, E-Mails und Informationen, die nicht durchsuchbar sind.</p>
      </div>
    </div>
  </Section>

  <!-- SERVICES SECTION: Lösungen mit Outcomes -->
  <Section
    alt
    label="[Was wir tun]"
    title="Automatisierung, die Ihre Prozesse <em class='hl'>übernimmt</em> – nicht nur begleitet."
    intro="Wir bauen nicht nur Tools. Wir bauen Systeme, die Arbeit wirklich abnehmen: vom ersten Workflow bis zur vollständigen Prozessautomatisierung."
  >
    <ul class="service-list reveal-stagger">
      <ServiceItem
        title="Multi-Agent Content Factory"
        description="Recherche, Texterstellung, Qualitätsprüfung und Veröffentlichung in einem automatisierten Workflow. Für Social Media, Blogs, Exposés und Newsrooms."
        outcome="Inhalte in Minuten statt Stunden, konsistente Qualität, 24/7 Verfügbarkeit."
      />
      <ServiceItem
        title="Workflow-Automatisierung mit n8n"
        description="Verbindung von CRM, Shop-System, E-Mail, Datenbanken und APIs zu robusten, wartbaren Prozessen. Inklusive Fehlerbehandlung und Monitoring."
        outcome="Manuelle Dateneingabe drastisch reduziert, Prozesse laufen zuverlässig 24/7."
      />
      <ServiceItem
        title="Lokale KI-Deployment (LLM)"
        description="Eigene Sprachmodelle auf Ihrer Infrastruktur mit Ollama und Llama. Keine Cloud-Abhängigkeit, keine Datenflüsse nach aussen."
        outcome="Vollständige Kontrolle über Daten und Modelle, keine API-Kosten, DSGVO-sicher."
      />
      <ServiceItem
        title="Intelligente Dokumentenverarbeitung"
        description="Automatische Extraktion, Klassifizierung und Verarbeitung von Dokumenten, Rechnungen, Verträgen und E-Mails mit KI."
        outcome="Stunden manueller Erfassung pro Woche eingespart, weniger Fehler, schnellere Durchlaufzeiten."
      />
    </ul>
  </Section>

  <!-- ZIELGRUPPE: Spezifität schafft Vertrauen -->
  <Section
    label="[Für wen]"
    title="Zwei Branchen. Eine Lösung: <em class='hl'>weniger Wiederholung.</em>"
  >
    <div class="audience-grid reveal-stagger">
      <div class="audience-card">
        <div class="audience-icon" set:html={iconContent} />
        <h3>Immobilienwirtschaft</h3>
        <ul>
          <li>Exposés automatisch aus Rohdaten generieren</li>
          <li>Anfragen vorqualifizieren und an den richtigen Mitarbeiter leiten</li>
          <li>Objektdaten zwischen Portalen synchronisieren</li>
          <li>Terminkoordination automatisieren</li>
        </ul>
      </div>
      <div class="audience-card">
        <div class="audience-icon" set:html={iconServer} />
        <h3>E-Commerce</h3>
        <ul>
          <li>Produktbeschreibungen in Großen Mengen generieren</li>
          <li>Kundenanfragen klassifizieren und automatisch beantworten</li>
          <li>Retouren-Workflows beschleunigen</li>
          <li>Lageralerts und Bestellvorgänge automatisieren</li>
        </ul>
      </div>
    </div>
  </Section>

  <!-- PROZESS: Zeigarnik-Effekt (Schritte motivieren zum Abschließen) -->
  <Section
    dark
    label="[So arbeiten wir]"
    title="Vom Problem zum <em class='hl'>laufenden Workflow</em> in 4 Schritten."
    intro="Kein 30-Seiten-Konzept. Keine wochenlangen Analysephasen. Wir starten mit einem konkreten Prototyp und iterieren von dort."
  >
    <div class="process-grid reveal-stagger">
      <div class="process-step">
        <div class="step-num">1</div>
        <h3>Analyse</h3>
        <p>Gemeinsam identifizieren wir den Prozess mit dem größten Automatisierungspotenzial. Kostenloser Ersttermin, 20 Minuten.</p>
      </div>
      <div class="process-step">
        <div class="step-num">2</div>
        <h3>Prototyp</h3>
        <p>In 3–5 Tagen bauen wir einen ersten lauffähigen Workflow, den Sie in Ihrem Betrieb testen können.</p>
      </div>
      <div class="process-step">
        <div class="step-num">3</div>
        <h3>Iteration</h3>
        <p>Wir verfeinern den Workflow basierend auf Ihrem Feedback, bis er zuverlässig und handhabbar ist.</p>
      </div>
      <div class="process-step">
        <div class="step-num">4</div>
        <h3>Übergabe</h3>
        <p>Vollständige Dokumentation, kurze Schulung Ihres Teams. Optional: Wartung und Weiterentwicklung.</p>
      </div>
    </div>
    <div class="process-cta">
      <a href="/kontakt" class="btn btn-primary btn-large">Schritt 1 starten →</a>
    </div>
  </Section>

  <!-- WARUM AGENDT: Differenzierung -->
  <Section
    label="[Warum agendt?]"
    title="Daten bleiben bei Ihnen. <em class='hl'>Kontrolle</em> bleibt bei Ihnen."
    intro="Die meisten KI-Dienstleister schicken Ihre Daten in US-Clouds. Das ist schnell gebaut, aber ein DSGVO-Risiko. Wir machen es anders."
  >
    <div class="why-grid reveal-stagger">
      <Card title="Self-Hosted First" body="Lokale Sprachmodelle auf Ihrer Infrastruktur. Wenn Sie wollen, funktioniert alles ohne Internetverbindung." icon={iconServer} />
      <Card title="DSGVO von Tag 1" body="Klare Datenflüsse, dokumentierte Schnittstellen, Verarbeitungsverzeichnis-tauglich. Keine Grauzonen." icon={iconShield} />
      <Card title="Schnell statt bürokratisch" body="Statt monatelanger Konzeptphasen: ein Prototyp in unter einer Woche. Danach iterieren wir gemeinsam." icon={iconProcess} />
      <Card title="Transparent & ehrlich" body="Sie verstehen, was passiert. Keine Blackbox. Volle Dokumentation. Keine versteckten Abhängigkeiten." icon={iconContent} />
    </div>
  </Section>

  <!-- FINAL CTA: Scarcity + Reciprocity -->
  <div class="cta-section">
    <div class="container">
      <div class="cta-content">
        <p class="cta-label">Kostenlos. Unverbindlich. In 24 Stunden.</p>
        <h2 class="cta-title">Bereit, Ihren ersten Workflow zu automatisieren?</h2>
        <p class="cta-text">
          Vereinbaren Sie ein 20-minütiges Erstgespräch. Wir analysieren gemeinsam, welcher Prozess sich am schnellsten automatisieren lässt – kostenlos und ohne Verpflichtung.
        </p>
        <a href="/kontakt" class="btn btn-primary btn-large">Kostenloses Erstgespräch buchen →</a>
        <p class="cta-fineprint">Keine Spam. Keine Verkaufsmasche. Nur konkrete Antworten.</p>
      </div>
    </div>
  </div>

  <script>
  // Count-up fuer Statistiken (Everlast-Stil), respektiert prefers-reduced-motion
  const nums = document.querySelectorAll('.stat-num[data-count]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window && nums.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        io.unobserve(entry.target);
        const el = entry.target;
        const target = parseInt(el.dataset.count, 10);
        const prefix = el.dataset.prefix || '';
        const suffix = el.dataset.suffix || '';
        const dur = 1600;
        const t0 = performance.now();
        const tick = (t) => {
          const p = Math.min((t - t0) / dur, 1);
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = prefix + Math.round(target * eased) + suffix;
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.4 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<ScrollReveal />
  <Footer />
</Base>

<style>
  /* STATS BAR */
  .stats-bar {
    background: var(--card);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 40px 0;
  }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: var(--accent-light);
    line-height: 1.1;
  }
  .stat-label {
    display: block;
    font-size: 0.85rem;
    color: var(--text-light);
    margin-top: 8px;
  }
  @media (max-width: 640px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
  }

  /* TECH-MARQUEE */
  .tech-marquee {
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .marquee-track {
    display: flex;
    gap: 18px;
    width: max-content;
    animation: marquee 36s linear infinite;
  }
  .tech-marquee:hover .marquee-track { animation-play-state: paused; }
  .tech-chip {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 8px 20px;
    white-space: nowrap;
    transition: color 0.2s, border-color 0.2s;
  }
  .tech-chip:hover { color: var(--accent-light); border-color: var(--accent); }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Sequenzieller Schritt-Puls (Everlast autoStepPulse-Stil) */
  .step-num {
    animation: stepPulse 4s ease-in-out infinite;
  }
  .process-step:nth-child(2) .step-num { animation-delay: 1s; }
  .process-step:nth-child(3) .step-num { animation-delay: 2s; }
  .process-step:nth-child(4) .step-num { animation-delay: 3s; }
  @keyframes stepPulse {
    0%, 18%, 100% { box-shadow: 0 0 0 0 rgba(212, 160, 23, 0); }
    8% { box-shadow: 0 0 0 10px rgba(212, 160, 23, 0.18); }
  }

  /* PAIN POINTS */
  .pain-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .pain-item {
    display: flex;
    gap: 16px;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    align-items: flex-start;
  }
  .pain-icon {
    font-size: 1.4rem;
    color: #F87171;
    flex-shrink: 0;
  }
  .pain-item p { font-size: 0.95rem; color: var(--text-muted); }
  .pain-item strong { color: var(--text); }
  @media (max-width: 640px) { .pain-grid { grid-template-columns: 1fr; } }

  /* SERVICE LIST */
  .service-list { list-style: none; }

  /* AUDIENCE */
  .audience-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .audience-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .audience-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-light);
  }
  .audience-icon {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent-bg);
    border-radius: var(--radius);
    color: var(--accent);
    margin-bottom: 20px;
  }
  .audience-icon :global(svg) { width: 24px; height: 24px; }
  .audience-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    color: var(--primary);
    margin-bottom: 16px;
  }
  .audience-card ul {
    list-style: none;
  }
  .audience-card li {
    position: relative;
    padding-left: 24px;
    font-size: 0.96rem;
    color: var(--text-muted);
    margin-bottom: 12px;
    line-height: 1.5;
  }
  .audience-card li::before {
    content: '\2713';
    position: absolute;
    left: 0;
    color: var(--success);
    font-weight: 700;
  }
  @media (max-width: 768px) { .audience-grid { grid-template-columns: 1fr; } }

  /* PROCESS */
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  .process-step {
    position: relative;
  }
  .step-num {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent);
    color: var(--text-inverse);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    border-radius: 50%;
    margin-bottom: 20px;
  }
  .process-step h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 10px;
  }
  .process-step p {
    font-size: 0.92rem;
    color: var(--text-light);
    line-height: 1.6;
  }
  .process-cta {
    text-align: center;
    margin-top: 48px;
  }
  @media (max-width: 768px) { .process-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .process-grid { grid-template-columns: 1fr; } }

  /* WHY GRID */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) { .why-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .why-grid { grid-template-columns: 1fr; } }

  /* FINAL CTA */
  .cta-section {
    background: var(--bg-alt);
    padding: 100px 0;
  }
  .cta-content {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }
  .cta-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .cta-title {
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    color: var(--primary);
    margin-bottom: 16px;
  }
  .cta-text {
    font-size: 1.1rem;
    color: var(--text-muted);
    margin-bottom: 32px;
  }
  .cta-fineprint {
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--text-light);
  }
</style>
