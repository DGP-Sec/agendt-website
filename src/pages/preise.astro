---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

// PREISE — zentral gepflegt, eine Stelle für Änderungen
const pakete = [
  {
    name: 'KI-Scan',
    preis: '0 €',
    einheit: 'kostenlos',
    tagline: 'Der Einstieg',
    dauer: '20–30 Minuten',
    features: [
      'Erstgespräch zu Ihren Abläufen',
      'Potenzial-Einschätzung: Was lohnt sich?',
      'Konkrete Empfehlung inkl. Priorität',
      'Keine Verpflichtung, kein Verkaufspitch',
    ],
    cta: { label: 'Termin vereinbaren', href: '/kontakt/' },
    highlight: false,
  },
  {
    name: 'Prototyp',
    preis: 'ab 1.500 €',
    einheit: 'Festpreis',
    tagline: 'Ein Prozess, automatisiert',
    dauer: '3–5 Tage',
    features: [
      'Ein vollständiger Workflow oder KI-Feature',
      'Lauffähig an echten Daten',
      'Eingebunden in Ihre Systeme',
      'Dokumentation und Einweisung',
      'Sie behalten alles: Code, Workflows, Daten',
    ],
    cta: { label: 'Prototyp anfragen', href: '/kontakt/' },
    highlight: true,
  },
  {
    name: 'Voll-Automatisierung',
    preis: 'ab 4.500 €',
    einheit: 'Projektpreis',
    tagline: 'Mehrere Prozesse, ein System',
    dauer: 'projektabhängig',
    features: [
      'Mehrstufige Workflows und KI-Agenten',
      'Anbindung an CRM, ERP, Shop, Postfach',
      'Fehlerbehandlung und Monitoring',
      'Schulung Ihres Teams',
      'Optional: fertiger Chatbot oder Text-Pipeline',
    ],
    cta: { label: 'Projekt besprechen', href: '/kontakt/' },
    highlight: false,
  },
  {
    name: 'Betrieb',
    preis: 'ab 190 €',
    einheit: 'pro Monat',
    tagline: 'Optional, kündbar',
    dauer: 'laufend',
    features: [
      'Monitoring und Fehlerbehebung',
      'Kleine Anpassungen inklusive',
      'Weiterentwicklung auf Wunsch',
      'Monatlich kündbar',
    ],
    cta: { label: 'Fragen zum Betrieb', href: '/kontakt/' },
    highlight: false,
  },
];

const faqs = [
  {
    q: 'Warum arbeiten Sie mit Festpreisen?',
    a: 'Weil Sie planen können müssen. Nach dem KI-Scan wissen wir, was der Prototyp kostet – und das gilt. Überraschungen bei der Rechnung sind ein Vertrauensbruch, den wir uns nicht leisten wollen.',
  },
  {
    q: 'Was passiert nach dem Prototyp?',
    a: 'Drei Wege: Sie übernehmen den Betrieb selbst (inklusive Dokumentation und Einweisung), wir entwickeln gemeinsam weiter, oder Sie buchen den laufenden Betrieb. Alle Wege sind von Anfang an offen – kein Lockangebot.',
  },
  {
    q: 'Fallen laufende Kosten durch die Technik an?',
    a: 'Bei self-hosted Lösungen auf Ihrer Infrastruktur: nein, außer den Kosten für Ihren eigenen Server. Wenn externe KI-APIs sinnvoll sind, empfehlen wir europäische Anbieter – die Kosten sind transparent und werden vorab beziffert.',
  },
  {
    q: 'Warum keine Stundensätze?',
    a: 'Stundensätze bestrafen Sie für unsere Lernkurve. Wenn wir einen Workflow zum dritten Mal bauen, ist er schneller fertig – dieser Vorteil soll bei Ihnen landen, nicht auf Ihrer Rechnung.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Preise', item: 'https://agendt.de/preise/' },
  ],
};
---

<Base
  title="Preise: KI-Automatisierung transparent | agendt.de"
  description="Transparente Preise für KI-Automatisierung: KI-Scan kostenlos, Prototyp ab 1.500 € Festpreis, Voll-Automatisierung ab 4.500 €. Keine versteckten Kosten."
>
  <Header />

  <section class="page-hero">
    <div class="container">
      <p class="hero-label">[Preise]</p>
      <h1 class="page-title">Faire Preise. Klare Leistung. <em class="hl">Keine Überraschungen.</em></h1>
      <p class="page-sub">
        Sie sollen von Anfang an wissen, was Sie erwarten. Deshalb: Festpreise nach gemeinsamer Analyse,
        keine versteckten Kosten, und alles was wir bauen gehört Ihnen.
      </p>
    </div>
  </section>

  <Section
    label="[Pakete]"
    title="Vom ersten Gespräch <em class='hl'>zum laufenden System.</em>"
    intro="Vier Stufen, eine Logik: gemeinsam finden wir heraus, was sich für Sie lohnt – und bauen es. Jede Stufe ist ein eigenständiger Abschluss, keine Stufe zwingt zur nächsten."
  >
    <div class="price-grid">
      {pakete.map((p) => (
        <div class:list={['price-card', { highlight: p.highlight }]}>
          {p.highlight && <span class="price-badge">Meistgewählt</span>}
          <p class="price-tagline">{p.tagline}</p>
          <h3 class="price-name">{p.name}</h3>
          <p class="price-value">{p.preis}</p>
          <p class="price-unit">{p.einheit} · {p.dauer}</p>
          <ul class="price-features">
            {p.features.map((f) => <li>{f}</li>)}
          </ul>
          <a href={p.cta.href} class:list={['btn', { 'btn-primary': p.highlight, 'btn-secondary': !p.highlight }]}>{p.cta.label} →</a>
        </div>
      ))}
    </div>
    <p class="price-note">
      Alle Preise zzgl. USt. „Ab“-Preise sind Startpunkte: Der konkrete Festpreis steht nach dem KI-Scan fest –
      verbindlich und schriftlich.
    </p>
  </Section>

  <Section
    alt
    label="[Prinzipien]"
    title="Warum wir <em class='hl'>anders kalkulieren.</em>"
  >
    <div class="prinzip-grid">
      <div class="prinzip">
        <h3>Alles gehört Ihnen</h3>
        <p>Code, Workflows, Konfigurationen, Dokumentation: Nach der Übergabe ist alles Ihr Eigentum. Kein Vendor-Lock-in, keine Abhängigkeit von uns.</p>
      </div>
      <div class="prinzip">
        <h3>Self-hosted spart Betriebskosten</h3>
        <p>Was auf Ihrer Infrastruktur läuft, verursacht keine laufenden Lizenz- oder Nutzungskosten. Wir richten es so ein, dass es funktioniert – ohne uns im kritischen Pfad.</p>
      </div>
      <div class="prinzip">
        <h3>Klein anfangen, beweisen, ausbauen</h3>
        <p>Statt Großprojekt mit sechs Monaten Konzeptphase: ein Prototyp in unter einer Woche. Wenn er Wert schafft, bauen wir aus. Wenn nicht, war es ein günstiger Test.</p>
      </div>
    </div>
  </Section>

  <Section dark>
    <div class="text-center">
      <h2 class="section-title">Unsicher, welches Paket passt?</h2>
      <p class="section-intro" style="margin: 0 auto 32px;">Muss es auch gar nicht. Genau dafür gibt es den kostenlosen KI-Scan.</p>
      <a href="/kontakt/" class="btn btn-primary btn-large">KI-Scan vereinbaren →</a>
    </div>
  </Section>

  <Section alt label="[FAQ]" title="Häufige Fragen <em class='hl'>zu Preisen und Ablauf.</em>">
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </Section>

  <ScrollReveal />
  <Footer />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
</Base>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--bg-alt) 0%, var(--bg) 100%);
    padding: 80px 0 60px;
  }
  .hero-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--accent); margin-bottom: 12px;
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--primary); margin-bottom: 20px; line-height: 1.2; max-width: 760px;
  }
  .page-sub { font-size: 1.15rem; color: var(--text-muted); max-width: 640px; }

  .price-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .price-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .price-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 0 24px rgba(212, 160, 23, 0.08), var(--shadow-lg);
    border-color: var(--accent-light);
  }
  .price-card.highlight {
    border-color: rgba(212, 160, 23, 0.5);
    box-shadow: 0 0 0 1px rgba(212, 160, 23, 0.25), 0 0 32px rgba(212, 160, 23, 0.08);
  }
  .price-badge {
    position: absolute;
    top: -12px; left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: var(--text-inverse);
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.72rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.06em;
    border-radius: 100px;
    padding: 5px 14px;
    white-space: nowrap;
  }
  .price-tagline {
    font-size: 0.8rem;
    color: var(--text-light);
    margin-bottom: 6px;
  }
  .price-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .price-value {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--accent-light);
    line-height: 1.1;
    margin-bottom: 4px;
  }
  .price-unit {
    font-size: 0.82rem;
    color: var(--text-light);
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border);
  }
  .price-features { list-style: none; margin-bottom: 28px; flex: 1; }
  .price-features li {
    position: relative;
    padding-left: 24px;
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 10px;
    line-height: 1.45;
  }
  .price-features li::before {
    content: '\\2713';
    position: absolute; left: 0;
    color: var(--success);
    font-weight: 700;
  }
  .price-note {
    margin-top: 32px;
    font-size: 0.88rem;
    color: var(--text-light);
    text-align: center;
  }
  @media (max-width: 1100px) { .price-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .price-grid { grid-template-columns: 1fr; } }

  .prinzip-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .prinzip {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
  }
  .prinzip h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .prinzip p { font-size: 0.94rem; color: var(--text-muted); line-height: 1.65; }
  @media (max-width: 960px) { .prinzip-grid { grid-template-columns: 1fr; } }

  .faq-list { max-width: 760px; margin: 0 auto; }
  .faq-item { border-bottom: 1px solid var(--border); }
  .faq-item summary {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.05rem; font-weight: 600; color: var(--primary);
    padding: 24px 0; cursor: pointer; list-style: none;
    position: relative; padding-right: 36px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+'; position: absolute; right: 4px; top: 50%;
    transform: translateY(-50%);
    color: var(--accent); font-size: 1.4rem; font-weight: 500;
    transition: transform 0.2s;
  }
  .faq-item[open] summary::after { transform: translateY(-50%) rotate(45deg); }
  .faq-item p {
    font-size: 0.96rem; color: var(--text-muted);
    line-height: 1.7; padding-bottom: 24px; max-width: 680px;
  }
</style>
