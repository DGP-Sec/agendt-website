---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import { icons } from '../lib/icons';

const services = [
  {
    href: '/leistungen/ki-beratung/',
    icon: 'target',
    title: 'KI-Beratung',
    short: 'Für den Einstieg',
    desc: 'Potenzialanalyse, Prozess-Mapping und KI-Strategie: Wir finden heraus, wo KI bei Ihnen wirklich etwas bringt – ehrlich bewertet, mit klarer Roadmap.',
  },
  {
    href: '/leistungen/chatbot/',
    icon: 'chat',
    title: 'KI-Chatbot',
    short: 'Für Kundenkommunikation',
    desc: 'Beantwortet Anfragen rund um die Uhr, qualifiziert Leads und bucht Termine – auf Ihrer Website, self-hosted und DSGVO-konform.',
  },
  {
    href: '/leistungen/ki-agent/',
    icon: 'bot',
    title: 'KI-Agenten',
    short: 'Für autonome Aufgabenketten',
    desc: 'Agenten, die selbstständig handeln: E-Mail-Triage, Datenextraktion, Recherche und Reporting – koordiniert als Multi-Agent-System.',
  },
  {
    href: '/leistungen/ki-texte/',
    icon: 'pen',
    title: 'KI-Texte',
    short: 'Für Content-Produktion',
    desc: 'Produktbeschreibungen, Exposé-Texte und SEO-Content in Ihrer Markensprache – mit menschlicher Qualitätssicherung vor jeder Veröffentlichung.',
  },
  {
    href: '/leistungen/automatisierung/',
    icon: 'gear',
    title: 'Automatisierung',
    short: 'Für Prozesse und Systeme',
    desc: 'n8n-Workflows, Dokumentenverarbeitung und Systemintegrationen: Prozesse, die automatisch laufen – auf Ihrer Infrastruktur.',
  },
];

const iconN8n = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6m11-7h-6m-6 0H1"/></svg>';
const iconLlm = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/></svg>';
const iconDb = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>';
const iconDocker = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="8" width="20" height="12" rx="2"/><line x1="6" y1="12" x2="6" y2="16"/><line x1="10" y1="12" x2="10" y2="16"/><line x1="14" y1="12" x2="14" y2="16"/></svg>';
---

<Base
  title="Leistungen: KI-Automatisierung, Chatbots & Agenten | agendt.de"
  description="Unsere Leistungen: KI-Chatbots, autonome KI-Agenten, KI-Texte und Prozessautomatisierung mit n8n. Für Immobilien und E-Commerce. DSGVO-konform."
>
  <Header />

  <h1 class="sr-only">Leistungen: KI-Automatisierung, Chatbots und KI-Agenten</h1>

  <!-- HERO -->

  <!-- SERVICE HUB -->
  <Section
    title="Fünf Wege zu <em class='hl'>weniger Routine.</em>"
    intro="Jede Leistung ist einzeln buchbar – und in Kombination stärker. Beginnen wir immer mit dem Prozess, der Ihnen den größten Nutzen bringt."
  >
    <div class="hub-grid reveal-stagger">
      {services.map((s) => (
        <a href={s.href} class="hub-card">
          <span class="hub-icon" set:html={icons[s.icon]} />
          <p class="hub-short">{s.short}</p>
          <h3 class="hub-title">{s.title}</h3>
          <p class="hub-desc">{s.desc}</p>
          <span class="hub-link">Mehr erfahren →</span>
        </a>
      ))}
    </div>
  </Section>

  <!-- TECH STACK -->
  <Section
    dark
    title="Tools, auf die wir uns verlassen."
    intro="Open-Source zuerst. Das bedeutet: keine teuren Lizenzen, keine Vendor-Lock-ins, volle Transparenz."
  >
    <div class="tech-grid reveal-stagger">
      <div class="tech-item">
        <div class="tech-icon" set:html={iconN8n} />
        <h3>n8n</h3>
        <p>Open-Source Workflow-Automation mit voller Kontrolle über Daten und Hosting.</p>
      </div>
      <div class="tech-item">
        <div class="tech-icon" set:html={iconLlm} />
        <h3>Ollama / Llama</h3>
        <p>Lokale Ausführung von Sprachmodellen ohne Cloud-Abhängigkeit.</p>
      </div>
      <div class="tech-item">
        <div class="tech-icon" set:html={iconDb} />
        <h3>Qdrant</h3>
        <p>Vektordatenbank für semantische Suche und KI-gestützte Wissensbasen.</p>
      </div>
      <div class="tech-item">
        <div class="tech-icon" set:html={iconDocker} />
        <h3>Docker / Linux</h3>
        <p>Containerisierte Deployment-Pipeline. Funktioniert überall, skaliert mit.</p>
      </div>
    </div>
  </Section>

  <!-- FAQ: Objection Handling -->
  <Section
    alt
    title="Was Geschäftsführer uns zuerst fragen."
  >
    <div class="faq-list reveal">
      <details class="faq-item">
        <summary>Wie viel kostet eine Automatisierung?</summary>
        <div class="faq-answer">
          <p>Transparent: KI-Scan kostenlos, Prototyp ab 1.500 € Festpreis, Voll-Automatisierung ab 4.500 €. Alle Details auf unserer <a href="/preise/">Preise-Seite</a>.</p>
        </div>
      </details>
      <details class="faq-item">
        <summary>Müssen unsere Daten in die Cloud?</summary>
        <div class="faq-answer">
          <p>Nein. Wir arbeiten primär mit self-hosted Lösungen (Ollama, Llama). Wenn externe Dienste nötig sind, wählen wir europäische Anbieter. US-Cloud-APIs (OpenAI, Google) setzen wir nur auf ausdrücklichen Wunsch ein.</p>
        </div>
      </details>
      <details class="faq-item">
        <summary>Was passiert, wenn etwas kaputtgeht?</summary>
        <div class="faq-answer">
          <p>Jeder Workflow wird mit Fehlerbehandlung, Logging und Monitoring ausgeliefert. Sie bekommen eine Dokumentation und wissen genau, was zu tun ist. Optional bieten wir Wartung im Betrieb an.</p>
        </div>
      </details>
      <details class="faq-item">
        <summary>Wir haben keine eigene IT-Abteilung. Geht das trotzdem?</summary>
        <div class="faq-answer">
          <p>Ja. Wir übernehmen Setup, Konfiguration und Betrieb. Sie müssen keine Server administrieren. Wenn Sie möchten, hosten wir auf einem dedizierten Server und Sie haben einen Ansprechpartner für alles.</p>
        </div>
      </details>
      <details class="faq-item">
        <summary>Wie lange dauert es, bis etwas läuft?</summary>
        <div class="faq-answer">
          <p>Ein erster Prototyp steht in der Regel innerhalb von 3–5 Werktagen. Die vollständige Implementierung und Iteration dauert je nach Komplexität 1–4 Wochen. Mehr dazu im <a href="/prozess/">Prozess-Ablauf</a>.</p>
        </div>
      </details>
    </div>
  </Section>

  <!-- CTA -->
  <div class="cta-section">
    <div class="container text-center">
      <h2 class="section-title">Bereit für den ersten Workflow?</h2>
      <p class="section-intro" style="margin: 0 auto 32px;">20 Minuten. Kostenlos. Konkret.</p>
      <a href="/kontakt/" class="btn btn-primary btn-large">Jetzt Erstgespräch vereinbaren →</a>
    </div>
  </div>

  <ScrollReveal />
  <Footer />
</Base>

<style>

  /* SERVICE HUB */
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  .hub-card {
    display: flex;
    flex-direction: column;
    background: rgba(31, 41, 55, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    padding: 36px 32px;
    border-bottom: 1px solid var(--border);
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .hub-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-light);
    box-shadow: 0 0 24px rgba(212, 160, 23, 0.08), var(--shadow-lg);
  }
  .hub-icon {
    width: 52px; height: 52px;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent-bg);
    border-radius: var(--radius);
    margin-bottom: 20px;
  }
  .hub-icon :global(svg) { width: 24px; height: 24px; }
  .hub-short {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .hub-title {
    font-family: 'Inter', sans-serif;
    font-size: 1.35rem;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .hub-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
    flex: 1;
  }
  .hub-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-light);
    align-self: flex-start;
    transition: color 0.2s;
  }
  .hub-card:hover .hub-link { color: var(--accent); }
  .hub-card:last-child:nth-child(odd) { grid-column: 1 / -1; }
  @media (max-width: 768px) { .hub-grid { grid-template-columns: 1fr; } }

  /* TECH GRID */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  .tech-item { text-align: center; }
  .tech-icon {
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(212, 160, 23, 0.12);
    border-radius: var(--radius);
    color: var(--accent-light);
    margin: 0 auto 20px;
  }
  .tech-icon :global(svg) { width: 28px; height: 28px; }
  .tech-item h3 {
    font-family: 'Inter', sans-serif;
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 10px;
  }
  .tech-item p {
    font-size: 0.9rem;
    color: var(--text-light);
    line-height: 1.6;
  }
  @media (max-width: 768px) { .tech-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .tech-grid { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq-list { max-width: 760px; margin: 0 auto; }
  .faq-item {
    border-bottom: 1px solid var(--border);
    padding: 0;
  }
  .faq-item summary {
    font-family: 'Inter', sans-serif;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--primary);
    padding: 24px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--accent);
    transition: transform 0.2s;
  }
  .faq-item[open] summary::after { transform: rotate(45deg); }
  .faq-item summary:hover { color: var(--accent); }
  .faq-answer {
    padding: 0 0 24px;
    font-size: 0.96rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* CTA */
  .cta-section {
    background: var(--bg-alt);
    padding: 80px 0;
  }
</style>
