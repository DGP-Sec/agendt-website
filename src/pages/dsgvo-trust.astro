---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<Base title="DSGVO & Trust — agendt.de" description="DSGVO-konforme KI-Architektur: self-hosted Modelle, europäische Infrastruktur, dokumentierte Datenflüsse.">
  <Header />

  <section class="page-hero">
    <div class="container">
      <p class="hero-label">[DSGVO & Trust]</p>
      <h1 class="page-title">Datenschutz ist<br>kein Anhang.</h1>
      <p class="page-sub">Datenschutz ist die Basis unserer Architektur – nicht eine Nachbesserung. Wir entwickeln Lösungen, bei denen sensible Informationen nach Möglichkeit auf Ihrer Infrastruktur bleiben.</p>
    </div>
  </section>

  <!-- PROBLEM: Warum überhaupt selbst hosten? -->
  <Section
    label="[Das Problem]"
    title="Die meisten KI-Dienstleister schicken Ihre Daten in die USA."
    intro="OpenAI, Anthropic, Google – alle haben Server in den USA. Nach dem Schrems-II-Urteil ist die Übertragung personenbezogener Daten dorthin rechtlich problematisch. Viele Unternehmen ignorieren das – wir nicht."
  >
    <div class="risk-callout">
      <p><strong>Was bedeutet Schrems II?</strong> Der Europäische Gerichtshof hat 2020 entschieden, dass die Übermittlung personenbezogener Daten in die USA unter dem EU-US Privacy Shield nicht rechtmäßig ist. Wer trotzdem Daten in US-Clouds überträgt, trägt das Risiko – inkl. Busgelder bis zu 20 Mio. € oder 4% des Jahresumsatzes.</p>
    </div>
  </Section>

  <!-- PRINZIPIEN -->
  <Section
    alt
    label="[Unsere Prinzipien]"
    title="Wie wir Datenschutz umsetzen – technisch."
  >
    <div class="principles-grid reveal-stagger">
      <Card title="Data Ownership" body="Ihre Daten bleiben auf Ihren Systemen oder bei europäischen Anbietern. Kein undokumentierter Transfer in Drittländer." />
      <Card title="Self-Hosted KI" body="Lokale Sprachmodelle mit Ollama/Llama. Funktionieren auch ohne Internetverbindung. Daten verlassen nie Ihr Netzwerk." />
      <Card title="Dokumentierte Schnittstellen" body="Wir dokumentieren alle Datenflüsse, Speicherorte und Betreiber – als Grundlage für Ihr Verarbeitungsverzeichnis (Art. 30 DSGVO)." />
      <Card title="Transparente Architektur" body="Keine Blackbox. Sie wissen genau, welche Komponenten laufen, wo sie laufen und wer Zugriff hat." />
    </div>
  </Section>

  <!-- VERGLEICH -->
  <Section
    label="[Vergleich]"
    title="Standard-KI vs. Unsere Architektur"
  >
    <div class="compare-table reveal">
      <div class="compare-row compare-head">
        <div class="compare-cell"></div>
        <div class="compare-cell">Standard-KI-Agentur</div>
        <div class="compare-cell highlight">agendt.de</div>
      </div>
      <div class="compare-row">
        <div class="compare-cell">Datenverarbeitung</div>
        <div class="compare-cell">US-Cloud (OpenAI, etc.)</div>
        <div class="compare-cell highlight">Self-hosted / EU-Cloud</div>
      </div>
      <div class="compare-row">
        <div class="compare-cell">DSGVO-Konformität</div>
        <div class="compare-cell">Grauzone / Schrems II-Risiko</div>
        <div class="compare-cell highlight">Von Architektur beginnend</div>
      </div>
      <div class="compare-row">
        <div class="compare-cell">API-Kosten</div>
        <div class="compare-cell">Fortlaufend, pro Token</div>
        <div class="compare-cell highlight">Einmalig (Hardware)</div>
      </div>
      <div class="compare-row">
        <div class="compare-cell">Abhängigkeit</div>
        <div class="compare-cell">Vendor Lock-in</div>
        <div class="compare-cell highlight">Open-Source, eigene Infrastruktur</div>
      </div>
      <div class="compare-row">
        <div class="compare-cell">Transparenz</div>
        <div class="compare-cell">Blackbox</div>
        <div class="compare-cell highlight">Vollständig dokumentiert</div>
      </div>
    </div>
  </Section>

  <!-- VERSPRECHEN -->
  <Section dark>
    <div class="text-center">
      <h2 class="section-title">Unser Versprechen</h2>
      <p class="section-intro" style="margin: 0 auto 40px;">Wir vermeiden US-Cloud-APIs, wo immer möglich. Wenn externe Dienste nötig sind, wählen wir europäische Anbieter. Sie entscheiden – mit allen Informationen.</p>
      <div class="promise-badges">
        <span class="promise-badge">Self-Hosted</span>
        <span class="promise-badge">Open-Source</span>
        <span class="promise-badge">Keine US-Cloud</span>
        <span class="promise-badge">DSGVO-konform</span>
        <span class="promise-badge">Dokumentiert</span>
      </div>
    </div>
  </Section>

  <!-- HINWEIS -->
  <Section alt>
    <div class="disclaimer-box">
      <h3>Rechtlicher Hinweis</h3>
      <p>Wir unterstützen bei der technischen Umsetzung datenschutzfreundlicher Systeme. Eine rechtsverbindliche Beurteilung der DSGVO-Konformität obliegt jedoch Ihrem Datenschutzbeauftragten oder Rechtsberater. Für Pilotprojekte empfehlen wir eine kurze Absprache mit der zuständigen Person.</p>
    </div>
  </Section>

  <ScrollReveal />
  <Footer />
</Base>

<style>
  .page-hero {
    background: linear-gradient(180deg, var(--bg-alt) 0%, #fff 100%);
    padding: 80px 0 60px;
  }
  .hero-label {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .page-title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    color: var(--primary);
    margin-bottom: 20px;
    line-height: 1.2;
  }
  .page-sub {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 680px;
  }

  /* RISK CALLOUT */
  .risk-callout {
    background: #fef2f2;
    border-left: 4px solid #dc2626;
    border-radius: 4px;
    padding: 24px 28px;
    max-width: 800px;
  }
  .risk-callout p {
    font-size: 0.96rem;
    color: var(--text);
    line-height: 1.7;
  }
  .risk-callout strong { color: #dc2626; }

  /* PRINCIPLES */
  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }
  @media (max-width: 960px) { .principles-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .principles-grid { grid-template-columns: 1fr; } }

  /* COMPARE TABLE */
  .compare-table {
    max-width: 800px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .compare-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 1px solid var(--border);
  }
  .compare-row:last-child { border-bottom: none; }
  .compare-cell {
    padding: 18px 20px;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .compare-head .compare-cell {
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    color: var(--primary);
    background: var(--bg-alt);
  }
  .compare-cell.highlight {
    background: var(--success-bg);
    color: var(--text);
    font-weight: 500;
  }
  .compare-head .compare-cell.highlight {
    color: var(--success);
    background: var(--success-bg);
  }
  @media (max-width: 640px) {
    .compare-row { grid-template-columns: 1fr; }
    .compare-cell { border-bottom: 1px solid var(--border); padding: 12px 16px; }
  }

  /* PROMISE BADGES */
  .promise-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .promise-badge {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-light);
    border: 1px solid rgba(212, 160, 23, 0.3);
    border-radius: var(--radius);
    padding: 10px 18px;
  }

  /* DISCLAIMER */
  .disclaimer-box {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }
  .disclaimer-box h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.1rem;
    color: var(--primary);
    margin-bottom: 12px;
  }
  .disclaimer-box p {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.7;
  }
</style>
