---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
---

<Base title="Kontakt — agendt.de" description="Kontaktiere agendt.de für KI-Automatisierung, n8n-Workflows und DSGVO-konforme KI-Systeme.">
  <Header />

  <hr class="divider">

  <Section
    title="[Kontakt]"
    headline="Schreib uns. Wir antworten innerhalb eines Werktags."
    intro="Am besten beschreibst du kurz, welchen Prozess du automatisieren möchtest. Wir melden uns mit einem konkreten Vorschlag für ein erstes Gespräch."
  >
    <div class="contact-grid">
      <div class="contact-card">
        <div class="contact-label">E-Mail</div>
        <a href="mailto:hello@agendt.de" class="contact-value">hello@agendt.de</a>
      </div>

      <div class="contact-card">
        <div class="contact-label">Anfrage</div>
        <p class="contact-text">Beschreibe deinen Prozess, deine Ziele und deinen ungefähren Zeitplan.</p>
      </div>

      <div class="contact-card">
        <div class="contact-label">Erstgespräch</div>
        <p class="contact-text">Kostenlos, unverbindlich, 20 Minuten. Gemeinsam klären wir, ob und wie wir helfen können.</p>
      </div>
    </div>
  </Section>

  <hr class="divider-wide-strong">

  <section class="cta" data-animate>
    <div class="page">
      <h2 class="cta-title">Bereit für den ersten Workflow?</h2>
      <a href="mailto:hello@agendt.de" class="cta-button">hello@agendt.de</a>
      <p class="cta-note">Wir freuen uns auf deine Nachricht.</p>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-top: 32px;
  }

  .contact-card {
    background: var(--bg-warm);
    border: 1px solid var(--divider);
    padding: 28px;
  }

  .contact-label {
    font-family: 'Space Mono', monospace;
    font-weight: 700;
    color: var(--accent);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .contact-value {
    font-family: 'Space Mono', monospace;
    font-size: 1.1rem;
    color: var(--accent);
    border-bottom: 1px solid var(--divider);
  }

  .contact-value:hover {
    border-bottom-color: var(--accent);
  }

  .contact-text {
    color: var(--text-muted);
    font-size: 0.98rem;
  }

  .cta {
    text-align: center;
    padding: 80px 0 100px;
  }

  .cta-title {
    font-family: 'Space Mono', monospace;
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    color: var(--accent);
    margin-bottom: 24px;
  }

  .cta-button {
    display: inline-block;
    font-family: 'Space Mono', monospace;
    font-size: 0.95rem;
    color: var(--bg);
    background: var(--accent);
    text-decoration: none;
    padding: 16px 32px;
    border: 2px solid var(--accent);
    transition: all 0.25s ease;
  }

  .cta-button:hover {
    background: transparent;
    color: var(--accent);
  }

  .cta-note {
    margin-top: 16px;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
